# Stage 1: Build static assets
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY tsconfig*.json vite.config.ts vite.admin.config.ts index.html admin.html ./
COPY src/ ./src/

RUN npm run build

# Stage 2: Serve Admin Dashboard via lightweight Nginx Alpine (~25MB image, ~4MB RAM)
FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx-admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 3002

CMD ["nginx", "-g", "daemon off;"]
