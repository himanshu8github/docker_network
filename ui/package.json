{
  "name": "cloudops-hub-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001 --host",
    "dev:user": "vite --port 3001 --host",
    "dev:admin": "vite --config vite.admin.config.ts --port 3002 --host",
    "build": "tsc && vite build && vite build --config vite.admin.config.ts",
    "preview": "vite preview --port 3001 --host",
    "preview:admin": "vite preview --config vite.admin.config.ts --port 3002 --host"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.2"
  }
}
